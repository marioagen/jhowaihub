{
    "name": "woopiai-hub",
    "version": "1.0.0",
    "private": true,
    "description": "WoopiAI Hub - Root package for formatting and linting",
    "scripts": {
        "format": "prettier --write \"**/*.{json,yml,yaml,md}\" --ignore-path .prettierignore",
        "format:check": "prettier --check \"**/*.{json,yml,yaml,md}\" --ignore-path .prettierignore",
        "format:frontend": "cd front-end/vueapp && npm run format",
        "lint:frontend": "cd front-end/vueapp && npm run lint"
    },
    "devDependencies": {
        "prettier": "^3.6.2"
    },
    "engines": {
        "node": ">=14.0.0"
    }
}
