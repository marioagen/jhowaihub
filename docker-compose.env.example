# Copie para .env na raiz do repositório (mesmo nível que docker-compose.yml) se quiser
# personalizar variáveis. Sem .env, docker-compose.yml usa valores por omissão para dev local.
#
# O Docker Compose carrega automaticamente o ficheiro .env do diretório de trabalho.

# SQL Server: por omissão o compose usa a mesma senha abaixo. Defina aqui se mudar a password
# no container — a connection string da API (utilizador sa) tem de coincidir.
# MSSQL_SA_PASSWORD=Strong!WortePass99

# RabbitMQ (opcional). Por omissão guest/guest — igual a Messaging.Brokers.RabbitMQ em appsettings.
# RABBITMQ_DEFAULT_USER=guest
# RABBITMQ_DEFAULT_PASS=guest
